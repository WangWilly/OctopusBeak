{
  "name": "octopus-beak",
  "version": "0.7.3",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1",
      "onFail": "error"
    }
  },
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node scripts/run-test-lane.mjs all",
    "test:ci": "node scripts/run-test-lane.mjs ci",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "prebuild:electron": "svelte-kit sync",
    "build:electron": "vite build --config electron.vite.config.ts",
    "site:dev": "vite site --host 127.0.0.1 --port 4173",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && npm run desktop:install-browsers && electron-forge package",
    "desktop:make": "npm run build && npm run desktop:install-browsers && electron-forge make",
    "desktop:packaged-browser-smoke": "node scripts/desktop-packaged-browser-smoke.mjs",
    "desktop:make:signed": "OCTOPUSBEAK_SIGN=1 npm run desktop:make",
    "desktop:install-browsers": "node scripts/desktop-browser-install.mjs",
    "desktop:runtime-probe": "ELECTRON_RUN_AS_NODE=1 electron electron/runtime-probe.cjs",
    "desktop:strip-types-probe": "ELECTRON_RUN_AS_NODE=1 electron --experimental-strip-types electron/strip-types-probe.ts",
    "check:actions-pinned": "node scripts/check-actions-pinned.mjs",
    "check:package-lock": "node scripts/check-package-lock.mjs",
    "check:pglite-spending-performance": "node --no-warnings --experimental-strip-types src/ledger/pglite/spending-performance.ts",
    "check:pglite-pairing-ui-performance": "node --no-warnings --experimental-strip-types scripts/check-pglite-pairing-ui-performance.mjs",
    "check:pglite-electron-ipc-performance": "node --no-warnings --experimental-strip-types scripts/check-pglite-electron-ipc-performance.mjs",
    "check:welcome-assets": "node --test scripts/welcome-assets.check.mjs",
    "check:desktop-browser-payload": "node --test scripts/desktop-browser-payload.check.mjs scripts/forge-config.check.mjs",
    "generate:welcome-assets": "node scripts/welcome-assets.mjs",
    "workflow:dev": "node --no-warnings --experimental-strip-types scripts/workflow-dev.ts",
    "run:seed-desktop-cdp-fixture": "node --no-warnings --experimental-strip-types scripts/seed-desktop-cdp-fixture.ts",
    "desktop:dev:cdp-fixture": "OCTOPUSBEAK_CDP_FIXTURE_USER_DATA=\"${OCTOPUSBEAK_CDP_FIXTURE_USER_DATA:-/tmp/octopusbeak-171-cdp}\" npm run run:seed-desktop-cdp-fixture -- \"${OCTOPUSBEAK_CDP_FIXTURE_USER_DATA:-/tmp/octopusbeak-171-cdp}\" && OCTOPUSBEAK_CDP_FIXTURE=171 OCTOPUSBEAK_USER_DATA=\"${OCTOPUSBEAK_CDP_FIXTURE_USER_DATA:-/tmp/octopusbeak-171-cdp}\" npm run desktop:dev -- --no-sandbox --disable-gpu",
    "pretest": "npm run build",
    "pretest:ci": "npm run build",
    "privacy-check": ".githooks/pre-commit",
    "secrets-check": "gitleaks dir . --config .gitleaks.toml --redact --verbose",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "d3-force": "^3.0.0",
    "mpg123-decoder": "^1.0.3",
    "onnxruntime-node": "^1.27.0",
    "parse5": "^8.0.1",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "sherpa-onnx-node": "^1.13.7",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.68.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.0.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^43.0.0",
    "layerchart": "^2.0.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "yaml": "^2.9.0"
  }
}
